      <aliases enabled='yes' />
      <column caption='Incidents per Student' datatype='integer' name='[Calculation_3505217168805889]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [Student ID], [Quarter] : SUM([Incident Count]) }' />
      </column>
      <column caption='Quarter Sort Order' datatype='integer' name='[Calculation_3505217169244162]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Quarter]&#10;  WHEN &quot;Q1&quot; THEN 1&#10;  WHEN &quot;Q2&quot; THEN 2&#10;  WHEN &quot;Q3&quot; THEN 3&#10;  WHEN &quot;Q4&quot; THEN 4&#10;END' />
      </column>
      <column caption='IEP + ELL' datatype='string' name='[Calculation_3505217169551363]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [IEP] = &quot;Yes&quot; AND [ELL] = &quot;Yes&quot; THEN &quot;IEP + ELL&quot;&#10;ELSEIF [IEP] = &quot;Yes&quot; THEN &quot;IEP Only&quot;&#10;ELSEIF [ELL] = &quot;Yes&quot; THEN &quot;ELL Only&quot;&#10;ELSE &quot;General Education&quot;&#10;END' />
      </column>
      <column caption='% Students in Intervention' datatype='real' hidden='true' name='[Calculation_3505217367437318]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF [Calculation_3505217367265285] = 1 &#10;THEN [Student ID] &#10;END)&#10;/&#10;COUNTD([Student ID])' />
      </column>
      <column caption='Student Full Name' datatype='string' name='[Calculation_3505218108047367]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[First Name] + &quot; &quot; +[Last Name]' />
      </column>
      <column caption='Student Filter' datatype='boolean' name='[Calculation_3505218109521928]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Calculation_3505218108047367] = [Parameters].[Student Full Name Parameter]' />
      </column>
      <column caption='Student Profile Label' datatype='string' name='[Calculation_3505218491678731]' role='measure' type='nominal'>
        <calculation class='tableau' formula='&quot;Grade: &quot; + STR(MAX([Grade])) +&#10;&quot;  |  IEP: &quot; + MAX([IEP]) +&#10;&quot;  |  ELL: &quot; + MAX([ELL])' />
      </column>
      <column datatype='string' name='[ELL]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;No&quot;' value='Non-ELL' />
          <alias key='&quot;Yes&quot;' value='ELL' />
        </aliases>
      </column>
      <column datatype='string' datatype-customized='true' name='[Grade]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;6&quot;' value='6th Grade' />
          <alias key='&quot;7&quot;' value='7th Grade' />
          <alias key='&quot;8&quot;' value='8th Grade' />
        </aliases>
      </column>
      <column datatype='string' name='[IEP]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;No&quot;' value='No IEP' />
